{
  "name": "gsap-react",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "High-performance animation framework with GSAP, CSS3, Lottie, and real-time Socket.IO",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=8.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "biome lint .",
    "lint:fix": "biome check --apply .",
    "format": "biome format .",
    "format:check": "biome check .",
    "lint+format": "pnpm run lint && pnpm run format",
    "pre-commit": "pnpm run lint+format",
    "docker:dev": "docker compose -f docker/docker-compose.yml --profile dev up",
    "docker:prod": "docker compose -p gsap-react -f docker/docker-compose.yml --profile prod up -d",
    "docker:stop": "docker compose -p gsap-react -f docker/docker-compose.yml --profile prod down --remove-orphans",
    "health-check": "bash scripts/health-check.sh",
    "deploy": "bash scripts/deploy.sh"
  },
  "dependencies": {
    "gsap": "^3.12.5",
    "lottie-react": "^2.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io-client": "^4.7.5",
    "web-vitals": "^4.2.4"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@biomejs/biome": "^2.5.12",
    "@types/node": "^26.4.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.2"
  },
  "husky": {
    "hooks": {
      "pre-commit": "pnpm run pre-commit"
    }
  }
}