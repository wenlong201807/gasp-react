# ============ VCS / CI / IDE — 构建无关 ============
.git
.github
.vscode
.idea
.claude
.gitignore

# ============ 敏感 — 绝不进镜像 ============
# .env 含真实值且会被 vite 打进 bundle；src 有 fallback，容器构建不需要
.env
.env.*

# ============ 依赖与产物 — 容器内重建 ============
node_modules
dist
dist-ssr
*.tsbuildinfo

# ============ 测试 / 工具 / 文档 — 构建不需要 ============
artifacts
.playwright
.playwright-cli
script
scripts
docs
*.md

# ============ 其余非构建必需 ============
# 镜像内只跑 `tsc -b && vite build`，不含 biome lint
biome.json
# 镜像固定 node:20.11.0，无需版本提示文件
.node-version
.nvmrc

# ============ OS / 杂项 ============
.DS_Store
*.log
.dockerignore
